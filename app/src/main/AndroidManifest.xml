<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos Vehicle: 좌석 착석·벨트(CAR_SEATS), 도어(CAR_DOORS), 기어(CAR_DRIVE), 와이퍼(CAR_WINDOWS) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- 도로 링크 신호: 조향각(낙하물 회피), 공조 내기순환(연기·매연). 브레이크 페달은 CAR_DRIVE -->
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />   <!-- 에어백 전개 읽기(사고 판단) — 앱 마켓 사전 승인 항목인지 확인 필요 -->   <!-- EV 충전구·충전 스위치·배터리 %: 충전기 고장·대기 공유 -->
    <!-- 합의한 만남 지점으로 순정 내비 안내 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 온디바이스 음성 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 표준 AAOS 속도 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />   <!-- 외기 온도(교량 결빙 주의) — AAOS 표준 normal 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TMAP SDK 가 지도 설정·타일을 받기 전에 망 상태를 본다(공식 샘플과 같다). 위치 권한은 쓰지 않는다 — 내 차 위치는 차량 신호·엔진에서 넣는다 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 연구 기록(경고 반응 로그, 참가자가 동의할 때만): 방향지시등(차로 변경 후보) 읽기, 차속 신호가 없는 차에서만 GPS 속도(좌표는 저장하지 않는다) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 위치 권한은 연구 기록이 켜진 빌드(debug·qa, release -Pmeeos.study=true)에만: 아니면 자리표시자가 쓰지 않는 이름이 된다 -->
    <uses-permission android:name="${studyLocationPermission}" />
    <!-- 순정 내비가 앞에 있어도 픽업(아이 폰 연결·탑승 판단)을 이어가는 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 11+ 패키지 가시성: 선언하지 않은 앱은 resolveActivity() 가 못 본다 — 응급 [119 전화 화면](MainActivity.dial)과
         연구 기록 공유 시트(StudyExport)가 다이얼러·공유 앱이 있어도 "없음"으로 끝나지 않게 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="${appLabel}"
        android:icon="${appIcon}"
        android:roundIcon="${appIcon}"
        tools:replace="android:allowBackup,android:label"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- 주/야간(uiMode)·창 크기(단독 1700 ↔ 내비와 분할 840) 전환은 화면만 다시 그린다 — 액티비티를 다시 만들면 픽업 세션·내장 서버가 끊긴다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|orientation">
            <!-- 주행 중 사용(DO): 주행 중에는 음성 + 큰 상태 표시만 노출 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo Action: "지수 데리러 가자" -->
            <intent-filter>
                <action android:name="START_PICKUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Gleo Action: "근처 주차장" -->
            <intent-filter>
                <action android:name="FIND_NEARBY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Gleo Action: 같은 길의 차들과 연결 시작 -->
            <intent-filter>
                <action android:name="START_ROAD_LINK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 시연 훅의 유일한 입구(2026-11-13): `adb shell am broadcast -n …/ai.meeos.tago.app.DemoHookReceiver -a ai.meeos.tago.DEMO_HOOK` + extras.
             DUMP 는 서명·특권 권한이라 일반 앱은 못 가지고 adb 셸만 가진다 → 다른 앱이 보내면 시스템이 거부한다. 훅이 꺼진 제품 빌드는 enabled=false -->
        <receiver
            android:name=".app.DemoHookReceiver"
            android:exported="true"
            android:enabled="${demoHooksEnabled}"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.meeos.tago.DEMO_HOOK" />
            </intent-filter>
        </receiver>
        <!-- 연구 기록 내보내기(공유 시트): files/study/ 의 세션 JSONL 만 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.study"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/study_paths" />
        </provider>
        <service
            android:name=".PickupService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an active family pickup session (local rider link and boarding detection) running while the stock navigation app is in front." />
        </service>
    </application>

</manifest>
