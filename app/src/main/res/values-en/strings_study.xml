    <string name="hl_study_consent">Join the research log?</string>
    <string name="sl_study_consent">Records how you respond to Gilbeot warnings · set up only while stopped</string>
    <string name="study_consent_title">Consent</string>
    <string name="study_consent_purpose">Purpose: to measure how much drivers actually slow down and follow the advised speed after a Gilbeot warning (possible crash, end of a jam, road-authority notice), replacing assumptions in our traffic simulation study with measured values.</string>
    <string name="study_consent_what">Recorded: once a second from 30 s before to 120 s after a warning — speed, acceleration, turn signal, steering, warning type and remaining distance, when the warning was shown and spoken, and when you touched the screen.</string>
    <string name="study_consent_not">Not recorded: name, plate number, location coordinates, start point, voice. Sessions are identified only by a random number.</string>
    <string name="study_consent_where">Stored in this car’s app only. Export and server upload happen only when you turn them on.</string>
    <string name="study_consent_stop">Stop any time: turn it off under [Research log] on the home screen.</string>

