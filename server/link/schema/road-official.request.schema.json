{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meeos:gilbeot-road:1:road-official.request",
  "title": "POST /api/road/official 요청",
  "description": "차가 순정 내비 TrafficStatus.trafficEventList 를 올린다. 허브는 ACCIDENT·ROAD_DAMAGE·DISASTER 만 쓰고(그 밖의 type 은 버림), 경로에서 1 km 넘게 떨어진 것도 버린다. 개수 상한은 두지 않는다(본문 64 KB 상한이 막는다).",
  "type": "object",
  "required": ["me", "events"],
  "properties": {
    "me": {"type": "string", "minLength": 1, "maxLength": 64},
    "t": {"type": "number", "minimum": 0},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "maxLength": 32},
          "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
          "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
          "s": {"type": ["number", "null"], "minimum": -1000000, "maximum": 1000000},
          "start": {"type": ["number", "null"], "description": "epoch 초(차가 ISO → 숫자로 바꿈)"},
          "end": {"type": ["number", "null"], "description": "epoch 초. 지나면 공식 해제"},
          "desc": {"type": ["string", "null"], "maxLength": 200, "description": "허브가 40자로 자른다"}
        }
      }
    }
  }
}
